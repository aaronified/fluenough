<?xml version="1.0" encoding="utf-8"?>
<!-- Written by tools/brand_android.py: the home-screen widget (#108). Its
     text is set by DueWidgetProvider; nothing here is a word. Text is in sp,
     so it follows the phone's text size, and every line is cut with an
     ellipsis rather than pushed out of the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/due_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/due_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/due_widget_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/due_widget_text_secondary"
        android:textDirection="locale"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/due_widget_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/due_widget_text"
        android:textDirection="locale"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/due_widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/due_widget_text_secondary"
        android:textDirection="locale"
        android:textSize="13sp" />
</LinearLayout>
