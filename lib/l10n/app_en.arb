  "skillRecognition": "Recognition",
  "@skillRecognition": {
    "description": "Seeing a word in the target language and choosing or matching its meaning: a step of a lesson, not reviewed on its own (ADR-0034)."
  },
  "skillScript": "Script",
  "@skillScript": {
    "description": "Name of Today's Script tile: reading and writing the letters of a script, the script decks' Recognition and Write together, apart from the word skills. A short noun, like Hear and Write."
