  "skillRecognitionSettingsTitle": "Seen words",
  "@skillRecognitionSettingsTitle": {
    "description": "Title of a skill’s switch in Settings, in the learner’s words. The skill is recognition: the learner sees a word and recalls or chooses its meaning. Sentence case. Elsewhere the skill keeps its short name."
  },
  "skillRecognitionSettingsOn": "See the word, recall its meaning",
  "@skillRecognitionSettingsOn": {
    "description": "Under a skill’s switch in Settings, while it is on. The skill is recognition: the learner sees a word and recalls or chooses its meaning. Shown while the switch is on: says what happens now, and changes the moment it is flipped."
  },
  "skillRecognitionSettingsOff": "No see-the-word questions",
  "@skillRecognitionSettingsOff": {
    "description": "Under a skill’s switch in Settings, while it is off. The skill is recognition: the learner sees a word and recalls or chooses its meaning. Shown while the switch is off: says what happens now, and changes the moment it is flipped."
  },
