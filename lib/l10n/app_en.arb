  "languageBarLabel": "Language shown: {language}, {position} of {count, plural, =1{1 language} other{{count} languages}}",
  "@languageBarLabel": {
    "description": "What the screen reader says of the language bar at the top of Today, Decks and Progress: the language shown, and its place among the languages the learner learns, as in \"Language shown: Bengali, 2 of 4 languages\".",
