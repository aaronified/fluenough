    "description": "The button on Progress's language bar, just before the bug report button, that counts every language's numbers together. Short: it sits in a 48 dp slot."
  },
  "languageBarAllLabel": "All languages",
  "@languageBarAllLabel": {
    "description": "What the screen reader calls Progress's All button, a toggle."
  },
  "languageBarAllHint": "show every language's numbers together",
  "@languageBarAllHint": {
    "description": "The screen reader's hint for Progress's All button, after \"Double-tap to\"."
  },
  "languageMenuLabel": "Language shown: {language}",
  "@languageMenuLabel": {
    "description": "Tooltip and screen-reader label of the language menu button at the top of a deck's or a unit's page, and what the screen reader says once the language bar at the top of Today, Decks and Progress shows another language. It names which language's lessons, decks and numbers the whole app shows. The placeholder is a language's name, such as \"Telugu\".",
