    "description": "A screen-reader action on the language bar, in place of a swipe: shows the next language the learner learns.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "Telugu"
      }
    }
  },
  "languageBarPrevious": "Previous language: {language}",
