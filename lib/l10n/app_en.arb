  "reviewTurnOnTitle": "Review decks?",
  "@reviewTurnOnTitle": {
    "description": "Title of the dialog shown when turning Review decks on."
  },
  "reviewTurnOnBody": "You get a rater code, made on this phone. Send your reviews to Fluenough from your own mail, always from the same mail address.",
  "@reviewTurnOnBody": {
