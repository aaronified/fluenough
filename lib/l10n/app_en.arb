    "description": "Short status where a count would be, when the phone has no voice for the language, so listening cannot be drilled."
  },
  "commonPercent": "{value}",
  "@commonPercent": {
    "description": "A percentage on its own, like a score or a size. The value is a fraction; 0.87 shows as 87%.",
    "placeholders": {
      "value": {
        "type": "double",
        "example": "0.87",
        "format": "percentPattern"
      }
