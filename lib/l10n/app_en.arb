  },
  "reviewOffensiveNoneWaiting": "None waiting to be rated or checked",
  "@reviewOffensiveNoneWaiting": {
    "description": "Under Offensive words on the Waiting for review page, when every offensive word in a deck waiting for review is rated, and every word like one has its pair confirmed or rejected."
  },
  "reviewOffensivePageTitle": "Offensive words in {language}",
  "@reviewOffensivePageTitle": {
    "description": "Title of a language's Offensive words review.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "Telugu"
      }
    }
  },
  "reviewOffensiveWhyTitle": "Why offensive words are here",
  "@reviewOffensiveWhyTitle": {
    "description": "Heading of the first screen of the Offensive words review, shown before any word."
  },
  "reviewOffensiveWhyRange": "Offensive words are not all alike. Some are deeply offensive, the kind no newspaper would print. Others are mild, and some are fine between friends while from a stranger they insult.",
  "@reviewOffensiveWhyRange": {
    "description": "First screen of the Offensive words review, before any word: the range of offensiveness."
  },
  "reviewOffensiveWhyUnderstand": "Fluenough teaches them so that learners understand abuse when they hear it, and never say a word without knowing what it means. Learners only ever recognise them: they are never asked to type or say one.",
  "@reviewOffensiveWhyUnderstand": {
    "description": "First screen of the Offensive words review: why the words are taught."
  },
  "reviewOffensiveWhyCulture": "How strong a word is depends on the language and the culture. A word that is mild in one can be far stronger in another, even where it means the same, and speakers from different regions can disagree.",
  "@reviewOffensiveWhyCulture": {
    "description": "First screen of the Offensive words review: cultural differences in severity."
  },
  "reviewOffensiveWhyRate": "So native speakers rate them. Rate each word for how offensive it is to native speakers in general, from 1 to 9, not to you, and say where you speak the language. Several speakers rate every word, and the middle rating sets its level.",
  "@reviewOffensiveWhyRate": {
    "description": "First screen of the Offensive words review: what the reviewer is asked to do."
  },
  "reviewOffensiveWhyApart": "These words never appear in the ordinary review of a deck or unit, and nor does the offensive word an ordinary one sounds or looks like. They wait here until you choose to check them.",
  "@reviewOffensiveWhyApart": {
    "description": "First screen of the Offensive words review, last line, in a quieter style."
  },
  "reviewOffensiveNotNow": "Not now",
  "@reviewOffensiveNotNow": {
    "description": "Button on the first two screens of the Offensive words review: leaves without showing any word."
  },
  "reviewOffensiveAgeBody": "The next screen shows offensive words in {language}, written in full, some of them deeply offensive. Go on only if you are 18 or over.",
  "@reviewOffensiveAgeBody": {
    "description": "Second screen of the Offensive words review, under Are you 18 or over?, asked every time before the words show.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "Telugu"
      }
    }
  },
  "reviewOffensiveWordsInfo": "Rate each word for how offensive it is to native speakers in general, not to you. Tap a word to see it whole. Ratings are sent with your review, by mail.",
  "@reviewOffensiveWordsInfo": {
    "description": "Info line at the top of a language's offensive words, once the reviewer has confirmed their age."
  },
  "reviewOffensiveProgress": "{rated} of {total} rated",
  "@reviewOffensiveProgress": {
    "description": "How many offensive words are rated, in a language's Offensive words review: at the top, and under each deck's name.",
    "placeholders": {
