      "language": {
        "type": "String",
        "example": "Bengali"
      },
      "position": {
        "type": "int",
        "example": "2"
      },
      "count": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "languageBarHint": "choose a language",
