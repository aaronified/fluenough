# Flutter / Dart
# `flutter create` regenerates these on every checkout and CI remakes them on
# every run. Committing them is AGENTS.md rule 4 — the entries below for paths
# inside them are kept because they are the ones that matter if someone
# un-ignores a platform folder deliberately.
/android/
/ios/
/.metadata
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.g.dart
*.freezed.dart
# Generated from lib/l10n/*.arb. The .arb files are the source.
lib/l10n/app_localizations*.dart
doc/api/

# Android
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/local.properties
android/key.properties
*.jks
*.keystore

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
**/Podfile.lock
**/xcuserdata/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Python (deck tools)
__pycache__/
*.py[cod]
.venv/
venv/

# Local scratch
/scratch/
*.log

# Transient checkouts made by isolated subagents. Never commit one — it is a
# whole second copy of the repository.
.claude/worktrees/
